-- Medicines table
CREATE TABLE medicines (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    dosage TEXT,
    frequency TEXT, -- e.g., "Twice a day"
    start_date DATE,
    end_date DATE,
    notes TEXT
);

-- Reminders table
CREATE TABLE reminders (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    medicine_id INTEGER,
    reminder_time TIME,
    date DATE,
    taken BOOLEAN DEFAULT FALSE,
    FOREIGN KEY (medicine_id) REFERENCES medicines(id)
);